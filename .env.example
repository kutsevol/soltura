DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/soltura

# Anthropic API key for text generation, glosses and answer judging.
# Create one at https://platform.claude.com/settings/keys and keep it only in .env (gitignored).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

SRS_DESIRED_RETENTION=0.9

# Local development only: act as this Telegram user without a Telegram login.
AUTH_DEV_TELEGRAM_USER_ID=1

LOG_LEVEL=INFO
